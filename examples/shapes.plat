// Variants, exhaustive match, traits, and Ruby-style trailing blocks.

type Shape =
  | Circle(radius: Float)
  | Rect(w: Float, h: Float)

trait Describe {
  fn describe(self) -> String
}

impl Describe for Shape {
  fn describe(self) -> String {
    match self {
      Circle(r) => "circle r=#{r}",
      Rect(w, h) => "rect #{w}x#{h}",
    }
  }
}

fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.14159f * r * r,
    Rect(w, h) => w * h,
  }
}

fn main() needs Console {
  let shapes = [Circle(1.0f), Rect(2.0f, 3.0f), Circle(0.5f)]

  // trailing block: second-class, so it can use `puts` (Console) from main
  shapes.each { |s| puts("#{s.describe}: area #{s.area}") }

  let big = shapes.filter { |s| s.area > 1.0f }
  puts("#{big.len} shapes have area > 1")

  // blocks may assign the caller's `var`s
  var total = 0.0f
  shapes.each { |s| total += s.area }
  puts("total area #{total}")
}
